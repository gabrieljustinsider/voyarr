# Voyarr Environment Variables Template
# Copy this file to .env and configure for your deployment.
#
# Secrets can be managed via:
#   - A plain .env file (SECRETS_PROVIDER=dotenv)
#   - 1Password CLI with op:// references (SECRETS_PROVIDER=op)
#     resolve value references with: npm run resolve-env (writes .env.portainer)
#   - Bitwarden CLI (SECRETS_PROVIDER=bitwarden)

# ==============================================================================
# 1. SECRETS PROVIDER
# ==============================================================================
SECRETS_PROVIDER=dotenv

# ==============================================================================
# 2. DEPLOYMENT TARGETS
# Each layer runs independently. Choose where each lives:
#   docker            — runs in a local Docker container
#   cloudflare-worker — deploys frontend build to a Cloudflare Worker (frontend only)
#   neon              — uses Neon serverless PostgreSQL (database only)
#   browserless-io    — uses hosted browserless.io (scraper only)
# ==============================================================================
FRONTEND_TARGET=docker      # docker | cloudflare-worker
BACKEND_API_TARGET=docker      # docker | cloudflare-worker
WORKERS_TARGET=docker
DATABASE_TARGET=docker
SCRAPER_BROWSER_TARGET=browserless-io

# ==============================================================================
# 3. MEDIA STORAGE (Bind-mounted — managed by you)
# ==============================================================================
HOST_MEDIA_PATH_1=/path/to/your/primary/media
HOST_MEDIA_PATH_2=/path/to/your/alt1/media
HOST_MEDIA_PATH_3=/path/to/your/alt2/media
HOST_DOWNLOAD_PATH=/path/to/your/downloads
CONTAINER_MEDIA_PATHS=/media/storage
DEFAULT_DOWNLOAD_PATH=/downloads

# ==============================================================================
# 4. CONTAINER SETTINGS & PERMISSIONS
# ==============================================================================
TZ=America/New_York
PUID=1000
PGID=1000
SUPPLEMENTARY_GID=1000

POSTGRES_DB=voyarr
POSTGRES_USER=voyarr_user
POSTGRES_PASSWORD=your_secure_password

SECRET_KEY=your_secret_key_here
MASTER_KEY=your_32_byte_hex_key

HOST=0.0.0.0
SSL_CERT_PATH=
SSL_KEY_PATH=
ROOT_PATH=

BACKEND_PORT=
FRONTEND_PORT=
REDIS_PORT=
POSTGRES_PORT=5432

COOKIE_SAMESITE=lax
COOKIE_SECURE=false
CORS_ORIGINS=
TRUST_FORWARDED_FOR=false

# Connection overrides (defaults to Postgres/Redis compose targets if left blank)
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# 5. CLOUDFLARE WORKER (if FRONTEND_TARGET=cloudflare-worker)
# Serves frontend SPA and proxies /api/* to the backend.
# ==============================================================================
FRONTEND_BACKEND_URL=https://your-tunnel.cfargotunnel.com
WORKER_NAME=voyarr

# ==============================================================================
# 6. CLOUDFLARE TUNNEL (exposes Docker backend to the internet)
# ==============================================================================
CLOUDFLARE_TUNNEL_TOKEN=

# ==============================================================================
# 7. NEON DATABASE (if DATABASE_TARGET=neon)
# ==============================================================================
NEON_DATABASE_URL=
NEON_POOLED_DATABASE_URL=

# ==============================================================================
# 8. AUTHENTICATION (SSO & OIDC)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# 9. INTEGRATIONS & TASK QUEUES
# ==============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_LOG_LEVEL=info

DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_ADMIN_CHANNEL_ID=

BROWSERLESS_TOKEN=
BROWSERLESS_URL=wss://chrome.browserless.io
DEFAULT_USER_AGENT=

# ==============================================================================
# 10. VPN SIDECAR (OPTIONAL)
# ==============================================================================
# VPN/WireGuard settings are configured in .env.vpn
# See .env.vpn.example for details.
