# Environment Variables for Voyarr
# Copy this file to .env and fill in your actual values

# ==============================================================================
# 🎬 1. MEDIA STORAGE CONFIGURATION (YOUR VIDEOS & DOWNLOADS)
# ==============================================================================
# 
# 💡 EXPLANATION: WHY ARE THERE MULTIPLE "MEDIA_ROOT" VARIABLES?
# ------------------------------------------------------------------------------
# To run inside Docker, Voyarr needs to know two different things:
# 1. HOST PATHS (MEDIA_ROOT_1, _2, _3): Where your files physically live on your 
#    NAS or computer. You must change these to point to your real folders.
# 2. CONTAINER SCANNER PATH (MEDIA_ROOT): Where the Voyarr app INSIDE the isolated
#    Docker container should look for these files.
#
# They are NOT redundant—they bridge the gap between your physical machine and 
# the virtual container:
#   - MEDIA_ROOT_1 (Host) is mounted to "/media/storage" (Inside Container)
#   - MEDIA_ROOT_2 (Host) is mounted to "/media/storage_alt1" (Inside Container)
#   - MEDIA_ROOT_3 (Host) is mounted to "/media/storage_alt2" (Inside Container)
#   - MEDIA_ROOT (Inside Container) lists which internal folder(s) to scan.
#
# ------------------------------------------------------------------------------
# 🟢 SINGLE-DRIVE SETUP (Recommended / 95% of users)
# ------------------------------------------------------------------------------
# If all your media is on one drive/folder, just set MEDIA_ROOT_1 and leave everything else default!
# Examples:
#   - On Synology NAS: MEDIA_ROOT_1=/volume1/video
#   - Custom folder:   MEDIA_ROOT_1=/home/user/movies
#
# Default: /media/storage
MEDIA_ROOT_1=/path/to/your/primary/media

# ------------------------------------------------------------------------------
# 🔵 MULTI-DRIVE / ADVANCED SETUP (Optional)
# ------------------------------------------------------------------------------
# If your media library is spread across multiple drives, configure these:
#
# 1. Additional Host Folders:
MEDIA_ROOT_2=/path/to/your/alt1/media
MEDIA_ROOT_3=/path/to/your/alt2/media

# 2. Container Scan Paths:
# Tells Voyarr which internal folders to scan. For a single drive, keep '/media/storage'.
# For multiple drives, list them as a comma-separated list of their container mounts:
# e.g., MEDIA_ROOT=/media/storage,/media/storage_alt1,/media/storage_alt2
MEDIA_ROOT=/media/storage

# 📥 Default Download Path
# Where new downloads are saved. By default, it will save inside a 'downloads' folder
# in your primary media folder. Override by specifying an absolute container path here.
# Default: /media/storage/downloads
DEFAULT_DOWNLOAD_PATH=/media/storage/downloads


# ==============================================================================
# 📂 2. ROOT PATHS FOR SYSTEM CONFIGURATIONS, DATABASE, & BACKUPS
# ==============================================================================
# 
# 💡 EXPLANATION: HYBRID VOLUME ARCHITECTURE & BACKUP SYSTEM
# ------------------------------------------------------------------------------
# Voyarr uses Docker Named Volumes backed by your custom host paths.
# This "Hybrid" setup ensures:
#   1. System files and databases are securely managed by Docker to prevent 
#      permission issues or accidental deletion during image updates/upgrades.
#   2. All files are fully visible and accessible in a real folder on your host 
#      (e.g., your Synology NAS) for simple manual backups.
#
# ⚠️ CRITICAL STEP:
# Inside your chosen root folder, you MUST pre-create the subfolders 'config', 
# 'db-data', 'backups', and 'certs' via your File Manager (e.g. Synology File Station) BEFORE 
# launching the container stack. If they do not exist, Docker will fail to start.
# 
# Examples: 
# - Default:       /volume1/docker/voyarr
# - Custom Drive:  /volume2/appdata/voyarr
#
# Default: /opt/voyarr
APP_ROOT=/volume1/docker/voyarr

# Default: /opt/voyarr/config
CONFIG_ROOT=/volume1/docker/voyarr/config
# Default: /opt/voyarr/db/data
DB_DATA_PATH=/volume1/docker/voyarr/db-data
# Default: /opt/voyarr/backups
BACKUP_ROOT=/volume1/docker/voyarr/backups
# Default: /opt/voyarr/certs
CERTS_ROOT=/volume1/docker/voyarr/certs

# ==============================================================================
# ⚙️ 3. STANDARD CONTAINER SETTINGS & SYSTEM PERMISSIONS
# ==============================================================================
#
# 🕒 Time Zone Sync (TZ)
# ------------------------------------------------------------------------------
# Set this to your local time zone. This ensures that automated cron backups,
# scraped timestamps, and UI scheduling align perfectly with your local time.
# Look up time zone values here: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York, Europe/London, Asia/Tokyo, Australia/Sydney
# Default: UTC
TZ=America/New_York

# 🔑 Host Permission Mapping (PUID & PGID)
# ------------------------------------------------------------------------------
# Map the container processes to a specific user and group on your host system.
# This prevents file permission locks on your NAS/host for downloads, logs, 
# configurations, and backups generated inside the container.
#
# 💡 HOW TO FIND YOUR PUID & PGID:
# Connect to your server/NAS via SSH and run the `id` command.
# e.g., uid=1000(user) gid=1000(user) -> PUID=1000, PGID=1000.
# On Synology, default admin accounts are often PUID=1026, PGID=100.
# Default: 1000
PUID=1000
# Default: 1000
PGID=1000


# Database Configuration
# You can use either DATABASE_URL or individual POSTGRES_* variables
# Uncomment the line(s) based on your preferred setup
# DATABASE_URL=postgresql://user:password@localhost:5432/voyarr
# Or use separate variables:
# Default: voyarr
# POSTGRES_DB=voyarr
# Default: voyarr_user
# POSTGRES_USER=voyarr_user
# Default: voyarr_password
# POSTGRES_PASSWORD=your_secure_password
# Default: db
# POSTGRES_HOST=db

# Backend Configuration
# Secret key for FastAPI sessions and JWT (you can use `openssl rand -hex 32` in terminal to generate a secure key)
SECRET_KEY=your_secret_key_here

# Master Key for AES-256-GCM encryption of credentials
# Generate a secure 32-byte key (you can use `openssl rand -hex 32` in terminal to generate a secure key)
MASTER_KEY=your_32_byte_hex_key

# Server Settings
# Default: 0.0.0.0
HOST=0.0.0.0

# SSL/TLS Configuration (Optional)
# If you are using your own certificate, place your files in your chosen CERTS_ROOT folder
# and point these variables to the container paths (e.g. /app/certs/cert.pem).
SSL_CERT_PATH=
SSL_KEY_PATH=

# Reverse Proxy Base URL (Root Path)
# If you are hosting Voyarr's API behind a reverse proxy (like Nginx or Traefik) under a 
# specific subpath (e.g., https://yourdomain.com/voyarr/api), set this to "/voyarr/api".
# Leave blank if hosting at the root domain.
ROOT_PATH=

# Host Ports Configuration (For Docker Deployments)
# If these are left blank/empty, Docker/Synology will randomly select an available port during
# the first-time installation, then permanently remember that assigned port (so it persists across
# updates and restarts). Assign a specific integer here (e.g. PORT=8000, FRONTEND_PORT=3000)
# to force a static port mapping.
# 
# 💡 IMPORTANT NOTE ON REDIS & POSTGRES PORTS:
# Voyarr's internal containers communicate securely on an isolated Docker network. You DO NOT 
# need to assign REDIS_PORT or POSTGRES_PORT for the app to function. These are strictly for 
# optional external host access (e.g., connecting a GUI tool like pgAdmin or RedisInsight from 
# your desktop). Leaving them blank is a security best practice for isolation!
# Default: 8000
PORT=
# Default: 3000
FRONTEND_PORT=
# Default: 6379
REDIS_PORT=
# Default: 5432
POSTGRES_PORT=5432

# Cookie Security Settings (For Session Persistence)
# Set to true if you want to use secure cookies (requires HTTPS)
# If set to true, cookies will only be sent over HTTPS connections
# SameSite: 'lax' (default), 'strict', or 'none' (requires COOKIE_SECURE=true)
# Default: lax
COOKIE_SAMESITE=lax
# Set to true if running over HTTPS. Required if COOKIE_SAMESITE=none
# Default: false
COOKIE_SECURE=false

# Frontend Configuration
# Base URL for the backend API (used in frontend)
# Default: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Security
# Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# 🔑 3a. OPENID CONNECT (OIDC) CONFIGURATION (Optional)
# ==============================================================================
# Enable centralized authentication with your existing identity provider
# (Keycloak, Authentik, Authelia, Azure AD / Entra ID, Okta, Google Workspace).
#
# 💡 SETUP STEPS:
# 1. Enable OIDC in the Voyarr Admin Settings → Account Security → Global Auth Policies.
# 2. Register Voyarr as an OIDC client/application in your identity provider.
# 3. Set the Redirect/Callback URI to: http://<your-voyarr-host>:8000/auth/oidc/callback
# 4. Fill in the variables below and restart the backend container.
#
# OIDC_CLIENT_ID: The client/application ID assigned by your identity provider.
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET: The client/application secret assigned by your identity provider.
OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL: The OpenID Connect discovery endpoint (usually ends in /.well-known/openid-configuration).
# Examples:
#   Keycloak:   https://keycloak.example.com/realms/myrealm/.well-known/openid-configuration
#   Authentik:  https://auth.example.com/application/o/voyarr/.well-known/openid-configuration
#   Azure AD:   https://login.microsoftonline.com/{tenant-id}/v2.0/.well-known/openid-configuration
#   Google:     https://accounts.google.com/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
# FRONTEND_URL: Where to redirect after successful OIDC login (your Voyarr frontend).
# Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Task Queue / Cache (Celery & Redis)
# Required for background tasks like downloads and phash generation
# Default: redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
# Default: redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Default: info
CELERY_LOG_LEVEL=info

# ==============================================================================
# 🔗 4. PEER-TO-PEER (P2P) LIBRARY & RECIPE SYNCING
# ==============================================================================
# Voyarr features peer-to-peer synchronization allowing multiple instances to
# safely reconcile scraper recipes and library metadata over secure tunnels.
#
# 💡 IMPORTANT NOTE ON PORTS & ENVIRONMENT:
# - All P2P synchronization operations are conducted via standard HTTP/HTTPS endpoints.
# - Outbound requests originate from the Celery worker / beat daemon and connect to
#   external nodes using standard outgoing HTTPS connections.
# - Inbound P2P endpoints are served under the existing "/p2p" FastAPI router prefix
#   (on the default backend PORT, e.g. 8000). No additional ports need to be exposed.
#
# 🛡️ SECURITY & REVERSE PROXY SETUP (Nginx / Traefik / Caddy / Cloudflare):
# If you run Voyarr behind a reverse proxy or Cloudflare tunnel, you MUST configure
# your proxy to allow and forward the following headers for remote syncs to succeed:
#   1. "x-api-key"
#   2. "X-P2P-Token"
#
# Nginx Configuration Example:
#   location /p2p/ {
#       proxy_pass http://voyarr-backend:8000/p2p/;
#       proxy_set_header Host $host;
#       proxy_set_header X-Real-IP $remote_addr;
#       proxy_set_header x-api-key $http_x_api_key;
#       proxy_set_header X-P2P-Token $http_x_p2p_token;
#   }
#
# Traefik Configuration Example (Middleware to pass headers is default, but verify):
#   - Ensure no middleware strips custom headers beginning with "X-".
#
# Celery Beat Requirement:
# - To run scheduled P2P sync background tasks automatically, you must ensure the
#   "celery_beat" service defined in the docker-compose file is running.
#   For manual P2P operations, only the standard "celery_worker" is required.


# ==============================================================================
# 🔒 5. VPN SIDECAR (GLUETUN) & BROWSERLESS CONFIGURATION
# ==============================================================================
# If deploying Voyarr via `docker-compose.vpn.yml` to route all outbound scraping,
# downloading, and API traffic through a secure VPN tunnel using Gluetun.
#
# 💡 BROWSERLESS SECURITY:
# - BROWSERLESS_TOKEN: Secures your headless Chrome debugging port inside the stack.
# Default: voyarr-secure-browserless-token
BROWSERLESS_TOKEN=voyarr-secure-browserless-token

# 💡 VPN TUNNEL SETTINGS:
# - VPN_SERVICE_PROVIDER: Your commercial VPN service name (e.g., mullvad, nordvpn, ivpn, surfshark, custom)
#   Full list of supported providers: https://github.com/qdm12/gluetun-wiki/blob/main/setup/providers.md
# VPN_SERVICE_PROVIDER=mullvad

# - VPN_TYPE: Connection protocol (e.g., wireguard or openvpn)
# VPN_TYPE=wireguard

# - WIREGUARD_PRIVATE_KEY: WireGuard 32-byte private key generated by your VPN provider
# WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here

# - WIREGUARD_ADDRESSES: The internal WireGuard interface IP address (and optional subnet mask)
# WIREGUARD_ADDRESSES=10.64.0.1/32

# - SERVER_COUNTRIES: Optional geolocation routing filter (e.g., Sweden, Switzerland, Germany)
# SERVER_COUNTRIES=Sweden

# - VPN_DOT: Enable DNS over TLS (DNS leak protection) inside the VPN
# VPN_DOT=on

# - VPN_DNS_KEEP_NAMESERVER: Keep DNS nameserver active
# VPN_DNS_KEEP_NAMESERVER=on

# 💡 INTERNAL ROUTING OVERRIDES (Required if using VPN):
# Because the VPN container places all services in the same network namespace, they must 
# communicate via localhost (127.0.0.1) instead of Docker DNS. Uncomment these if VPN is active:
# BROWSERLESS_URL=ws://127.0.0.1:3000
# HOST=127.0.0.1