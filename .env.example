# Environment Variables for Voyarr
# Copy this file to .env and fill in your actual values

# Media Root Directory
# The absolute path to your media storage directory on the host
MEDIA_ROOT=/path/to/your/media

# Database Configuration
# You can use either DATABASE_URL or individual POSTGRES_* variables
# DATABASE_URL=postgresql://user:password@localhost:5432/voyarr
# Or use separate variables:
# POSTGRES_DB=voyarr
# POSTGRES_USER=voyarr_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Backend Configuration
# Secret key for FastAPI sessions and JWT (you can use `openssl rand -hex 32` in terminal to generate a secure key)
SECRET_KEY=your_secret_key_here

# Master Key for AES-256-GCM encryption of credentials
# Generate a secure 32-byte key (you can use `openssl rand -hex 32` in terminal to generate a secure key)
MASTER_KEY=your_32_byte_hex_key

# Integration API Keys
# API key for ThePornDB
THEPORNDB_API_KEY=your_theporndb_api_key

# API key for StashDB
STASHDB_API_KEY=your_stashdb_api_key

# Stash Configuration
# URL of your Stash instance
STASH_URL=http://localhost:9999

# Browser Extension Configuration
# If needed for extension communication
# You can use `openssl rand -hex 32` in terminal to generate a secure key
EXTENSION_SECRET=your_extension_secret

# Server Settings
HOST=0.0.0.0
PORT=8000

# Frontend Configuration
# Base URL for the backend API (used in frontend)
VITE_API_BASE_URL=http://localhost:8000