# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jizzarr

# NAS Media Root
NAS_MEDIA_ROOT=/media/nas

# Master Key for Encryption (generate a secure random key)
MASTER_KEY=your-256-bit-key-here

# API Keys for integrations
THEPORNDB_API_KEY=your-api-key
STASHDB_API_KEY=your-api-key

# Browser Extension Secret
EXTENSION_SECRET=your-secret-here

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001