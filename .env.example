# Voyarr Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Refer to README.md and USER_GUIDE.md for detailed explanations of these variables.

# ==============================================================================
# 1. MEDIA STORAGE CONFIGURATION
# ==============================================================================
HOST_MEDIA_PATH_1=/path/to/your/primary/media
HOST_MEDIA_PATH_2=/path/to/your/alt1/media
HOST_MEDIA_PATH_3=/path/to/your/alt2/media
CONTAINER_MEDIA_PATHS=/media/storage
DEFAULT_DOWNLOAD_PATH=/media/storage/downloads

# ==============================================================================
# 2. SYSTEM DATA PERSISTENCE
# ==============================================================================
CONFIG_ROOT=/volume1/docker/voyarr/config
DB_DATA_PATH=/volume1/docker/voyarr/db-data
BACKUP_ROOT=/volume1/docker/voyarr/backups

# ==============================================================================
# 3. CONTAINER SETTINGS & PERMISSIONS
# ==============================================================================
TZ=America/New_York
PUID=1000
PGID=1000
SUPPLEMENTARY_GID=1000

POSTGRES_DB=voyarr
POSTGRES_USER=voyarr_user
POSTGRES_PASSWORD=your_secure_password
# DATABASE_URL=postgresql://voyarr_user:your_secure_password@db:5432/voyarr

SECRET_KEY=your_secret_key_here
MASTER_KEY=your_32_byte_hex_key

HOST=0.0.0.0
SSL_CERT_PATH=
SSL_KEY_PATH=
ROOT_PATH=

BACKEND_PORT=
FRONTEND_PORT=
REDIS_PORT=
POSTGRES_PORT=5432

COOKIE_SAMESITE=lax
COOKIE_SECURE=false
CORS_ORIGINS=

# ==============================================================================
# 4. AUTHENTICATION (SSO & OIDC)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# 5. INTEGRATIONS & TASK QUEUES
# ==============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_LOG_LEVEL=info

DISCORD_BOT_TOKEN=

BROWSERLESS_TOKEN=
BROWSERLESS_URL=wss://chrome.browserless.io

# ==============================================================================
# 6. VPN SIDECAR (OPTIONAL)
# ==============================================================================
# Reminder: All VPN/WireGuard settings are configured in `.env.vpn`
# See .env.vpn.example for details.