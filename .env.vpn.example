# VPN Sidecar Environment Variables for Voyarr (Gluetun)
# Copy this file to .env.vpn in your Voyarr folder and fill in your VPN credentials

# ==============================================================================
# 🔒 VPN TUNNEL CONFIGURATION (GLUETUN)
# ==============================================================================

# 💡 VPN_SERVICE_PROVIDER
# The name of your commercial VPN provider (e.g., mullvad, nordvpn, ivpn, surfshark, custom)
# Full list of supported providers: https://github.com/qdm12/gluetun-wiki/blob/main/setup/providers.md
VPN_SERVICE_PROVIDER=mullvad

# 💡 VPN_TYPE
# The connection protocol to use (wireguard or openvpn)
VPN_TYPE=wireguard

# 💡 WIREGUARD_PRIVATE_KEY
# The 32-byte private key generated by your VPN provider for this specific device profile
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here

# 💡 WIREGUARD_ADDRESSES
# The internal WireGuard interface IP address (and subnet) assigned by your VPN provider
WIREGUARD_ADDRESSES=10.64.0.1/32

# 💡 SERVER_COUNTRIES
# Geolocation routing filter to restrict tunnels to specific countries (comma-separated, e.g. Sweden,Switzerland)
SERVER_COUNTRIES=Sweden

# 💡 VPN_DOT (DNS over TLS)
# Enables secure DNS over TLS inside the VPN tunnel to prevent DNS leaks
# Default: on
VPN_DOT=on

# 💡 VPN_DNS_KEEP_NAMESERVER
# Instructs the VPN to preserve your DNS nameserver settings
# Default: on
VPN_DNS_KEEP_NAMESERVER=on
