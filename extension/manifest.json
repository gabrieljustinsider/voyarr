{
  "manifest_version": 3,
  "name": "Voyarr Lens",
  "version": "1.198.1",
  "description": "Voyarr companion extension for visual CSS mapping, element scoping, and automated proactive tab discovery with auto-pairing.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://10.*.*.*",
    "https://10.*.*.*",
    "http://172.16.*.*",
    "https://172.16.*.*",
    "http://172.17.*.*",
    "https://172.17.*.*",
    "http://172.18.*.*",
    "https://172.18.*.*",
    "http://172.19.*.*",
    "https://172.19.*.*",
    "http://172.20.*.*",
    "https://172.20.*.*",
    "http://172.21.*.*",
    "https://172.21.*.*",
    "http://172.22.*.*",
    "https://172.22.*.*",
    "http://172.23.*.*",
    "https://172.23.*.*",
    "http://172.24.*.*",
    "https://172.24.*.*",
    "http://172.25.*.*",
    "https://172.25.*.*",
    "http://172.26.*.*",
    "https://172.26.*.*",
    "http://172.27.*.*",
    "https://172.27.*.*",
    "http://172.28.*.*",
    "https://172.28.*.*",
    "http://172.29.*.*",
    "https://172.29.*.*",
    "http://172.30.*.*",
    "https://172.30.*.*",
    "http://172.31.*.*",
    "https://172.31.*.*",
    "http://192.168.*.*",
    "https://192.168.*.*",
    "https://*/*",
    "http://*/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-map-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "Toggle Voyarr Map Mode"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detect-pairing.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
