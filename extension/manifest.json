{
  "manifest_version": 3,
  "name": "Voyarr Remote",
  "version": "1.0",
  "description": "Voyarr companion extension for visual CSS mapping and remote control.",
  "permissions": ["activeTab", "storage", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}