{
  "manifest_version": 3,
  "name": "Voyarr Lens",
  "version": "1.14.1",
  "description": "Voyarr companion extension for visual CSS mapping and element scoping.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://192.168.*/*",
    "http://10.*/*",
    "http://172.16.*/*",
    "http://172.17.*/*",
    "http://172.18.*/*",
    "http://172.19.*/*",
    "http://172.20.*/*",
    "http://172.21.*/*",
    "http://172.22.*/*",
    "http://172.23.*/*",
    "http://172.24.*/*",
    "http://172.25.*/*",
    "http://172.26.*/*",
    "http://172.27.*/*",
    "http://172.28.*/*",
    "http://172.29.*/*",
    "http://172.30.*/*",
    "http://172.31.*/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-map-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "Toggle Voyarr Map Mode"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
