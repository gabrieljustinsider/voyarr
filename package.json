{
  "name": "voyarr",
  "version": "1.21.1",
  "description": "Media downloader/manager and metadata scraper",
  "main": "index.js",
  "scripts": {
    "start": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build -d",
    "stop": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run build",
    "test:backend": "cd backend && ../venv/bin/ruff check . && PYTHONPATH=. ../venv/bin/pytest",
    "build": "cd frontend && npm install && npm run build",
    "version": "node -e \"const fs = require('fs'); fs.writeFileSync('VERSION', process.env.npm_package_version + '\\n');\" && python3 sync_version.py && git add -u"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrieljustinsider/voyarr.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gabrieljustinsider/voyarr/issues"
  },
  "homepage": "https://github.com/gabrieljustinsider/voyarr#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
