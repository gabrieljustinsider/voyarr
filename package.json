{
  "name": "voyarr",
  "version": "1.173.0",
  "description": "Media downloader/manager and metadata scraper",
  "main": "index.js",
  "scripts": {
    "deploy": "npm run build && wrangler deploy",
    "resolve-env": "bash scripts/resolve-env.sh",
    "deploy:frontend": "bash deploy/frontend/deploy.sh",
    "deploy:backend-api": "bash deploy/backend-api/deploy.sh",
    "deploy:workers": "bash deploy/workers/deploy.sh",
    "deploy:database": "bash deploy/database/deploy.sh",
    "deploy:scraper": "bash deploy/scraper-browser/deploy.sh",
    "up": "bash deploy/compose.sh up -d",
    "down": "bash deploy/compose.sh down",
    "dev": "docker compose --env-file .env.dev --env-file .env.dev.local -f docker-compose.base.yml -f docker-compose.dev.yml up --build -d",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run build",
    "test:backend": "cd backend && ../venv/bin/ruff check . && PYTHONPATH=. ../venv/bin/pytest",
    "build": "cd frontend && npm install && npm run build",
    "version": "python3 sync_version.py && git add -u",
    "preview": "wrangler dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrieljustinsider/voyarr.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gabrieljustinsider/voyarr/issues"
  },
  "homepage": "https://github.com/gabrieljustinsider/voyarr#readme",
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.0.2",
    "glob": "^10.5.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "anymatch": "^3.1.3",
    "uuid": "^11.1.1",
    "tough-cookie": "^4.1.4",
    "qs": "^6.14.1",
    "form-data": "^4.0.6",
    "node-notifier": "^10.0.1",
    "rimraf": "^3.0.2",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.3.1",
    "undici": "^7.29.0"
  }
}
