{
  "name": "voyarr",
  "version": "1.5.1",
  "description": "Media downloader/manager and metadata scraper",
  "main": "index.js",
  "scripts": {
    "start": "docker compose up --build -d",
    "stop": "docker compose down",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run build",
    "test:backend": "cd backend && ruff check . && pytest",
    "build": "cd frontend && npm install && npm run build",
    "version": "node -e \"require('fs').writeFileSync('VERSION', process.env.npm_package_version + '\\n')\" && git add VERSION"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrieljustinsider/voyarr.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gabrieljustinsider/voyarr/issues"
  },
  "homepage": "https://github.com/gabrieljustinsider/voyarr#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
