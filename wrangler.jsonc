{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voyarr",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend/dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
