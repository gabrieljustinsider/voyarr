{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voyarr",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-07-21",
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "frontend/dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
